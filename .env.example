# RetailSMS Configuration Example

# Web Portal & REST API Server Port
PORT=3000

# Default Sender ID / Originator Address
DEFAULT_SENDER=RetailAlert

# SMPP SMS Aggregator Connection Settings
SMPP_HOST=smpp.your-aggregator.com
SMPP_PORT=2775
SMPP_SYSTEM_ID=your_system_id
SMPP_PASSWORD=your_password
SMPP_SYSTEM_TYPE=
SMPP_BIND_MODE=transceiver

# Numbering Plans (TON & NPI)
# Source: 5 = Alphanumeric (e.g. BrandName), 1 = International
SMPP_SOURCE_TON=5
SMPP_SOURCE_NPI=0
# Destination: 1 = International (e.g. +1234567890)
SMPP_DEST_TON=1
SMPP_DEST_NPI=1

# Throughput Limit (Transactions Per Second / TPS)
SMPP_TPS_LIMIT=10

# Keepalive EnquireLink Interval (Seconds)
SMPP_KEEPALIVE_INTERVAL=30

# Automatically connect on startup
SMPP_AUTO_CONNECT=true

# Built-in Mock SMPP Server (Simulator) for zero-setup local testing
SIMULATOR_ENABLED=false
SIMULATOR_PORT=2775
